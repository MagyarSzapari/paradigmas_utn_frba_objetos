	test "con planBasico milenium2 no esta disponible para ver" {
		assert.throwsExceptionWithMessage("El contenido no está disponible en su plan actual.", 
	}
}

describe "test puntuar un contenido"{
	test "si el contenido ya fue visto se puede puntuar"{
		margo.ver(avengersEndgame)
		margo.puntuarContenido(avengersEndgame, 4)
		assert.that(avengersEndgame.puntuacion() == 4)
	}

	test "si el contenido no fue visto no se puede puntuar" {
		assert.throwsExceptionWithMessage("No tenes visto este contenido", 
			{margo.puntuarContenido(it, 3)})
	}
  
	test "el puntaje que se le quiere dar a un contenido visto debe ser entre 1 y 5"{
		margo.ver(it)
		assert.throwsExceptionWithMessage("El puntaje debe ser entre 1 y 5", 
			{margo.puntuarContenido(it, 6)})
	}
}


describe "test crear perfil sin recomendador"{
	const jorgito = margoZavala.crearPerfil("jorgito", 1999)

	test "jorgito utiliza el recomendador por defecto"{
		assert.that(jorgito.recomendador() == recomedadorPorDefecto)
	}
}


describe "test crear perfil infantil"{
	const lilMarto = margoZavala.crearPerfil("lil marto", 2013)

	test "lilMarto es menor, utiliza el recomendador infantil"{
		assert.that(lilMarto.recomendador() == controlParental)
	}
}
